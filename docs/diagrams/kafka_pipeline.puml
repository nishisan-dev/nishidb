@startuml kafka_pipeline
title Ingestão Kafka — do fetch ao commit, na ordem que o §48 fixa

participant "Kafka broker" as kafka
participant "Poller\n(1 goroutine)" as poll
participant "Fila limitada\nregistros + bytes" as fila
participant "Writer único\n(§27)" as wr
participant "Materializer" as mat
participant "Store" as st

== consume ==
poll -> kafka : PollRecords(maxPollRecords)
activate poll
note right of poll
  BlockRebalanceOnPoll: nenhuma partição é
  revogada enquanto o lote está em voo, então
  o commit seguinte só toca partição que ainda
  é nossa.
end note
kafka --> poll : lote de records

loop cada record
  poll -> fila : Envia(record)
  alt fila cheia (registros OU bytes)
    fila --> poll : BLOQUEIA
    note right of fila
      §29: reduz o intake, preserva a membership
      e mantém os heartbeats — que seguem na
      goroutine do cliente. Nenhuma mensagem
      se perde; o fetch é que espera.
    end note
  end
end
poll -> kafka : AllowRebalance
note right of poll
  Logo depois de enfileirar, SEM esperar o writer.
  Aqui havia uma barreira de fim de lote, e ela
  custava o overlap inteiro: writer 72% ocioso,
  poller 28% parado nela (medido no piloto).
  O dreno mora agora na revogação — ver Quiesce.
end note
deactivate poll

== materialize (em paralelo com o próximo poll) ==
loop enquanto houver item
  wr -> fila : Recebe()
  fila --> wr : record
  wr -> mat : Apply(record.Value)
  activate mat
  mat --> wr : ApplyResult
  deactivate mat

  alt aplicado, stale, ou descartado por log-and-skip
    wr -> wr : offsets[p] = record.Offset + 1
  else STORAGE_ERROR, writer falho, ou invalidEvent=stop
    wr -> wr : PARA sem avançar o offset
    note right of wr
      A posição fica apontando para o evento
      problemático: é o que permite ao operador
      vê-lo e decidir com `nishidb offsets`.
      As consultas seguem de pé (§51).
    end note
  end
end

== persist + durable checkpoint ==
alt cadência atingida (contagem OU tempo)
  wr -> st : SetSourceOffsets(offsets)
  wr -> st : Checkpoint()
  activate st
  st -> st : fdatasync do segmento
  st -> st : msync dos índices
  st -> st : manifest.bin (tmp→fsync→rename→fsync dir)
  st -> st : kafka.offsets  **DEPOIS** do manifest
  note right of st
    A ordem é a única proteção: são dois renames
    sem transação. Crash entre eles deixa o offset
    ATRÁS dos dados (reprocessa, converge). O
    inverso perderia os eventos do meio para sempre.
  end note
  st --> wr : ok
  deactivate st

  == commit Kafka offset ==
  wr -> kafka : CommitOffsetsSync
  note right of wr
    Por último, e nunca antes (§48). Falhar aqui
    NÃO é fatal: o checkpoint local é autoritativo
    (§49) e o commit existe para lag e terceiros.
  end note
end

== quiesce (só na revogação e no encerramento) ==
kafka -> poll : OnPartitionsRevoked
activate poll
poll -> fila : EnviaBarreira()
note right of fila
  A barreira vai para o FIM da fila: tudo o que
  entrou antes dela já terá sido aplicado quando
  o writer a alcançar. É essa a garantia de que
  nenhum commit toca partição já revogada.
end note
fila -> wr : barreira
wr -> wr : checkpoint incondicional
wr --> poll : conclui(err)
note right of poll
  O select tem TRÊS braços: a barreira, o writer
  já encerrado, e o contexto. Sem o segundo, um
  writer que saiu por ErrPausado travaria este
  callback — o group cairia e a ingestão morreria
  em silêncio.
end note
deactivate poll

@enduml
