@startuml contadores_flow
title Contador mantido na escrita: os quatro momentos e a auditoria

skinparam shadowing false
skinparam defaultFontName Helvetica

partition "Escrita (applyRecord, sob wmu)" {
  start
  :record durável no segmento;
  :passos 3-7: offset accounting,
  primary, SET do índice por segmento,
  sequence, PUBLICA a location;
  :7b agenda de vencimentos;
  :7c contadores;
  if (lápide?) then (sim)
    :nova = WithoutGroup;
  else (não)
    :Derive(payload):
    chave composta (valuekey) + where;
    if (grupo novo?) then (sim)
      :Renderiza o groupKey pelo molde
      (keyformat) e confere colisão;
      if (texto já é de outro grupo vivo?) then (sim)
        :ERRO, e NADA foi ao disco
        (a guarda vem ANTES do Intern:
        chave colidente durável faria
        toda abertura seguinte falhar);
        stop
      endif
      :Interna no dicionário
      (só o append, sem fsync: o id
      é visível e ainda não durável);
    endif
    :nova = id | conditionBit;
  endif
  :antiga = overlay[rowId] ou mmap[rowId];
  if (antiga == nova) then (sim)
    :nada a fazer
    (reprocessamento);
    stop
  endif
  :inc(nova) e depois dec(antiga)
  em totais e refs por grupo
  e nos agregados linhas e total
  (atômicos, colados uns aos outros);
  :overlay[rowId] = nova;
  stop
}

partition "Checkpoint" {
  start
  :segSync (records duráveis);
  :ApplyOverlay das locations;
  :ApplyOverlay dos contadores:
  1º fsync do grupos.dict se sujo
  (syncDictContadores; falha = writer falho),
  depois os Sets no vetor
  (o mmap nunca fica à frente do log
  nem do dicionário durável);
  if (dreno > 65.536 e > 4x a média?) then (sim)
    :troca o mapa do overlay
    (devolve o pico ao GC);
  endif
  :msync ... msync dos contadores;
  :RecordCoveredTouches(transições)
  (autoriza a aposentadoria);
  :manifest com a seção 0x0001
  (nome, colunas, where) e a 0x0002
  (piso: bytes fsyncados do grupos.dict);
  :remove o marcador building
  das construções adotadas;
  stop
}

partition "Abertura" {
  start
  :campos de sistema e indexados
  no dicionário (ordem contratual);
  :callback CompilaContadores(dict):
  compila o schema e as definições;
  :abre o grupos.dict: fsync da cauda
  herdada (abertura sincronizada);
  if (marcador building, manifest sem a seção,
  colunas/where diferentes, dicionário
  abaixo do piso ou vetor não cobre as linhas?) then (sim)
    :grava o marcador building
    e recria os dois arquivos
    (reconstrução pendente);
  else (não)
    :DOBRA: totais e refs por grupo
    e os agregados linhas e total,
    a partir do vetor em disco;
  endif
  :replay da recovery
  (cada record passa pelo 7c);
  if (reconstrução pendente?) then (sim)
    :varre as linhas vivas
    e transiciona cada uma;
  endif
  stop
}

partition "Auditoria (rota ADMIN)" {
  start
  :sob wmu por microssegundos:
  OpenSnapshot + AuditSnapshot(totais, refs);
  :solta o wmu;
  :enumerador próprio:
  linha com location e sem lápide
  na versão T0 (journal), rederiva
  com um Deriver próprio;
  if (snapshot expirou?) then (sim)
    :SNAPSHOT_TOO_OLD
    (inconclusiva);
    stop
  endif
  :compara com a cópia T0:
  divergentes por grupo;
  stop
}

@enduml
