@startuml c4_container
!define RECTANGLE class
title NishiDB — containers (M1, com os dois listeners HTTP da Fase 11 e a replicação com feed em disco)

skinparam componentStyle rectangle
skinparam defaultTextAlignment center

actor "Operador" as op
actor "Cliente remoto\n(nishidb query --server,\ndriver JDBC da Fase 7)" as cli #lightgray
actor "Painel / script de update / cron\n(loopback, sem credencial)" as local #lightgray

package "nishidb (binário único)" {
  component "CLI\ninternal/cli" as cliapp
  component "Servidor HTTP\ninternal/server" as srv
  component "Materializer\ninternal/materializer" as mat
  component "Engine SQL\ninternal/query" as eng
  component "Storage\ninternal/storage\n+ internal/index" as sto
  component "Feed de replicação\ninternal/replication\n(cache em memória + log de\nsegmentos em disco, gravador próprio)" as feed
  component "Publicador da replicação\ninternal/replicationkafka\n(checkpoint por destino)" as pub
  component "_meta.replication\ninternal/metareplication" as metarepl
}

actor "Follower\n(outro nishidb, role: follower)" as follower #lightgray
queue "Tópico Kafka da replicação\n(replication.targets → kafkaTargets:)" as kafkaout #lightgray

database "Dataset em disco" as ds {
  file "data/segment-00000001.dat\n(append-only)" as seg
  file "indexes/primary.idx\nindexes/locations.idx\nindexes/sequences.idx\n(mmap)" as idx
  file "data/segment-00000001.sidx\níndice do segmento (uma seção por campo)" as bmp
  file "metadata/fields.dict" as fdic
  file "checkpoint/manifest.bin" as man
  file "LOCK\n(flock exclusivo)" as lock
  file "replication/feed/<sequence>.seg + state\n(log do feed, retenção por maxDiskBytes;\nmarca limpa e impressão dos Stores)" as feedlog
  file "replication/kafka/<destino>.ckpt + .resync\n(checkpoint do publicador e\npedidos de snapshot)" as ckpt
}

queue "Kafka\n(M2 — fora do M1)" as kafka #lightgray

op --> cliapp : nishidb ingest\nnishidb query
cli --> srv : listener EXPOSTO\nTLS + HTTP Basic em TODA rota\n(§74-77, Fase 11)
local --> srv : listener LOOPBACK opcional\n(server.loopback.enabled)\nsem TLS/auth — rota ADMIN sai 403
kafka ..> mat : eventos\n(M2)

cliapp --> mat : eventos NDJSON
cliapp --> eng : SQL
srv --> eng : /v1/query, /v1/metadata,\n/v1/stats, /v1/health, /metrics
srv --> sto : /v1/compact, /v1/checkpoint\n(ADMIN, síncronas)
mat --> sto : Put(key, seq, payload, prev)
eng --> sto : GetByKey / GetByRowID\nScanLive / Lookup
sto --> seg
sto --> idx
sto --> bmp
sto --> fdic
sto --> man
sto --> lock
sto --> feed : Publish sob o wmu, depois do commit\n(master com replication.enabled; sem I/O)
feed --> feedlog : gravador: quadros com CRC,\nretenção por bytes; state com a\nmarca limpa no encerramento
follower --> srv : /v1/replication/*\n(ADMIN)
srv --> feed : cursor, lotes, snapshot
srv --> pub : POST /v1/replication/resync\n(ADMIN): RequestSnapshot grava o .resync
feed --> pub : lotes (Acquire, da memória ou do disco)
pub --> sto : snapshot em blocos curtos
pub --> ckpt : posição confirmada pelos acks;\nretoma dali no reinício limpo
pub --> kafkaout : envelope JSON\n(reset, snapshot, snapshot_end, resume, tail)
eng --> metarepl : SELECT * FROM _meta.replication
metarepl ..> feed : Status (piso, produzido, disco, cache)
metarepl ..> pub : Stats (estado, cursor, checkpoint, atraso)

note right of eng
  lexer → parser → binder
  → planner → executor → NDJSON
end note

note bottom of sto
  Writer único serializado;
  leitores concorrentes.
  Close faz quiesce e solta o
  flock POR ÚLTIMO, depois de
  fechar todos os arquivos.
end note

note bottom of bmp
  Um diretório por FieldID (5 dígitos),
  uma posting por valorID (8 dígitos).
end note

note right of srv
  Os dois listeners compartilham a mesma
  FUNÇÃO de definição de rota (buildMux),
  chamada uma vez por listener — nunca
  duas listas que poderiam divergir.
  A matriz do §77 decide se o servidor
  SOBE: bind exposto sem a seção
  authentication no arquivo é recusa,
  não silêncio.
end note
@enduml
