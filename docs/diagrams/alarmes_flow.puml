@startuml alarmes_flow
title Alarme por condição sustentada: a passada, a qualificação, a decisão e o que sai

skinparam shadowing false
skinparam defaultFontName Helvetica

partition "Subida (openDataset)" {
  start
  :Compila o `when` e o `qualifyWhen` de cada alarme
  contra o schema da tabela do contador, com as
  colunas das métricas de janela
  (internal/predicate, o MESMO do WHERE);
  note right
    Nome de coluna errado, texto acima do
    que o alarms.state comporta, SQL de
    enriquecimento malformado ou contagem
    de `?` divergente DERRUBAM a subida aqui.
  end note
  :Lê checkpoint/alarms.state (versão 2);
  if (arquivo?) then (ausente)
    :primeira subida: nada a restaurar;
  elseif (ilegível, ou versão 1 da v0.8.x) then
    :WARN alarm.state_unreadable;
    :cada alarme recomeça a contar
    (a abertura NÃO é recusada);
  else (válido)
    if (when, qualifyWhen, sustainedFor e impressão
das métricas citadas batem com o YAML?) then (não)
      :descarta a entrada
      (prazo antigo sobre regra nova
      anunciaria sustentação que
      ninguém mediu);
    else (sim)
      :restaura o `desde quando`
      pela chave CANÔNICA do grupo;
    endif
  endif
  :Publica o retrato para `_meta.alarms`;
}

partition "Passada (cadência = menor sustainedFor / 4)" {
  :Para cada grupo VIVO do contador;
  note right
    Só o lock FOLHA do dicionário,
    nada do Store: a varredura não
    disputa nada com a ingestão.
  end note
  :Avalia o `when` sobre a linha
  que a tabela virtual monta;
  if (grupo já tem estado?) then (não)
    if (condição vale?) then (não)
      :nada a lembrar
      (caso dominante, zero alocação);
      stop
    endif
  endif
  if (condição vale?) then (sim)
    :Avalia o `qualifyWhen`
    (sem ele declarado, qualificado);
    note right
      Só com a condição valendo: com ela
      falsa o desfecho já está decidido.
      Coluna de métrica sem amostra é
      NULL, e NULL não qualifica.
    end note
  endif
  if (grupo já tem estado?) then (não)
    if (qualificado?) then (não)
      :nada a lembrar
      (a OLT que nunca teve ninguém);
      stop
    endif
    :cria o cronômetro;
  endif
  if (condição vale?) then (não)
    if (estava disparado?) then (sim)
      :RESOLVED / condition_cleared;
    else (não)
      :nada
      (rajada curta: resolução sem
      disparo seria um "voltou" que
      ninguém viu abrir);
      stop
    endif
  elseif (qualificado?) then (não)
    if (estava disparado?) then (sim)
      :RESOLVED / disqualified;
      note right
        A OLT morta há mais de 24h: a condição
        ainda vale, mas auth_24h_max caiu abaixo
        do limiar. Só volta a disparar depois de
        requalificar E sustentar o prazo inteiro.
      end note
    else (não)
      :volta ao início SEM evento
      (nunca houve disparo a resolver);
      stop
    endif
  elseif (prazo cumprido?) then (não)
    :nada, segue contando;
    stop
  elseif (já disparado?) then (sim)
    :nada, não repete;
    stop
  else (dispara)
    :FIRING;
    :Enriquecimento: executa as consultas
    com os valores do grupo LIGADOS como
    parâmetro, fora de qualquer lock;
    note right
      Falha, prazo estourado ou teto da
      passada deixam o bloco vazio COM o
      motivo. A consulta NUNCA barra o
      alarme.
    end note
  endif
}

partition "Fase dois: quem a varredura não viu" {
  :Grupo com estado que não apareceu
  foi APOSENTADO pelo contador;
  if (estava disparado?) then (sim)
    :RESOLVED / group_retired;
    note right
      Precedência dos motivos na mesma passada:
      group_retired > condition_cleared > disqualified.
      Equipamento removido do inventário
      não é equipamento recuperado.
    end note
  else (não)
    :descarta o estado em silêncio;
  endif
}

partition "Saída" {
  :Evento no log estruturado
  (alarm.firing / alarm.resolved, com
  qualifyCondition quando declarada e as
  colunas de métrica no grupo `metrics`,
  lidas da MESMA linha que decidiu);
  if (houve transição?) then (sim)
    :republica o retrato de `_meta.alarms`
    (com qualifyCondition);
    :grava checkpoint/alarms.state
    (temp -> fsync -> rename -> dirsync);
  endif
  stop
}

@enduml
